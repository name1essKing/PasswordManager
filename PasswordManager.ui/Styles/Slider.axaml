<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border Padding="20" Background="#18181B" Width="400">
            <Slider Value="12" Minimum="4" Maximum="32"/>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Slider:horizontal">
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>

        <!-- Обычное состояние -->
        <Style Selector="^ /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Blue200}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource Blue200}"/>
        </Style>

        <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{StaticResource Grey500}"/>
        </Style>

        <!-- Наведение мышкой -->
        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{StaticResource Blue100}"/>
            </Style>

            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{StaticResource Blue100}"/>
            </Style>
        </Style>

        <!-- Нажатие -->
        <Style Selector="^:pressed">
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{StaticResource Blue300}"/>
            </Style>

            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{StaticResource Blue300}"/>
            </Style>
        </Style>
    </Style>

</Styles>