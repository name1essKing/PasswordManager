<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Design.PreviewWith>
    <Border Padding="20" Background="#18181B">
      <StackPanel Width="300" Spacing="8">
        <TextBlock Classes="header" Text="Менеджер паролей"/>
        <TextBlock Classes="sub-header" Text="Настройки"/>
        <TextBlock Classes="label" Text="Длина пароля:"/>
        <TextBlock Classes="slider-value" Text="12"/>
        <TextBlock Classes="password" Text="1111апрке13!№;%"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WhiteMain}" />
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.sub-header">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="TextBlock.slider-value">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,-14,0,0" />
    </Style>

    <Style Selector="TextBlock.password">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>


</Styles>