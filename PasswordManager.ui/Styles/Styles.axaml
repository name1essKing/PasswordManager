  <Styles.Resources>
      <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
              <ResourceInclude Source="avares://PasswordManager.UI/Styles/Colors.axaml"/>
              </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
  </Styles.Resources>
  
  <!-- Add Styles Here -->
	<Styles>
