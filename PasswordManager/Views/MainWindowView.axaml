<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.Client.Views"
        xmlns:pm="using:PasswordManager.Client.Views.PasswordManager"
        Background="#1e1e1e"
        mc:Ignorable="d" 
        Width="700" Height="550"
        CanResize="False"
        x:Class="PasswordManager.Client.Views.MainWindowView"
        x:DataType="vm:MainWindowViewModel"
        Title="Менеджер паролей"
        WindowStartupLocation="CenterScreen">

    <Grid 
        ColumnDefinitions="0.35*, auto, 0.65*">
        
        <Panel 
            Grid.Column="0">
            <pm:PasswordOptionsView 
                x:DataType="vm:PasswordOptionsViewModel"
                DataContext="{Binding PasswordOptionsViewModel}"/>
        </Panel>
        
        <Separator 
            Grid.Column="1" 
            Classes="vertical-separator"/>
        
        <Panel 
            Grid.Column="2">
            <pm:PasswordResultsView 
                x:DataType="vm:PasswordResultsViewModel"
                DataContext="{Binding PasswordResultsViewModel}"/>
        </Panel>
    </Grid>
</Window>